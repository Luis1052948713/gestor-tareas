# Copia este archivo como .env y ajusta los valores
PORT=3000

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017/gestor_tareas
# MongoDB Atlas (reemplaza la línea anterior por la cadena de tu clúster):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (se usa también con Atlas)
DB_NAME=gestor_tareas

# Cambia esto por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRES_IN=7d
