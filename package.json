{
  "name": "gestor-tareas",
  "version": "1.0.0",
  "description": "Gestor de tareas con Node.js, Express y MongoDB - Trabajo final de Programación distribuida",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
